python3
zstd
rustup
golang-go
gnat
pyenv
git
curl
adb
fastboot
ripgrep
fzf
bat
starship
zsh
kde-spectacle

# Apps básicas para usuarios generales / chicos (sin terminal)
kate
gwenview
ark
okular
kcalc
falkon

# OweeLinux Fase 4: bajo consumo + branding
zram-tools
plymouth
plymouth-themes

# Fuentes (cobertura amplia de idiomas: latín, cirílico/ruso, griego, CJK)
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji
