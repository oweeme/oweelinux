#!/bin/sh
# Genera el menú de GRUB (/boot/owee/grub.cfg) a partir de las entradas BLS de ostree.
# Debe ejecutarse tras CUALQUIER cambio de despliegues (upgrade, rollback, deploy): ostree
# alterna entre boot.0 y boot.1, así que una configuración fija deja de funcionar.
#
# Arranque "a prueba" (rollback automático):
#   grubenv/trial=1      -> el próximo arranque usa la entrada más nueva y GRUB borra la marca
#                           (la versión nueva solo tiene UN intento);
#   grubenv/confirmed=ID -> sin prueba pendiente, se arranca esta entrada (la última buena).
# Si la versión nueva no llega a "confirmarse" (owee-health), el siguiente arranque vuelve
# solo a la confirmada. En GRUB el id de la entrada lleva el prefijo "owee-": un `default`
# que empieza por dígitos se interpreta como NÚMERO de entrada, no como id (bug real visto en pruebas).
# ID = "<commit>.<serie>" del despliegue (ver owee-id).
# Uso: owee-bootcfg [DIR_BOOT]   (por defecto /boot). La entrada más nueva va primero.
set -eu
BOOT=${1:-/boot}
OUT=$BOOT/owee/grub.cfg; ENV=$BOOT/owee/grubenv
EXTRA="rd.shell=0 rd.emergency=reboot panic=5 splash loglevel=3 vt.global_cursor_default=0 rd.udev.log_level=3"   # si el arranque falla, reiniciar en vez de quedarse colgado; «splash» = logo en vez de texto; loglevel=3 oculta los avisos de firmware (ACPI) que no son un fallo
mkdir -p "$BOOT/owee"
ROOT=$(dirname "$BOOT")
id_of() { echo "$1" | owee-id "$ROOT"; }
n=0; first=""; body=$(mktemp); chain=$(mktemp)
# ¿Hay OTRO sistema (Windows u otro Linux) en la partición EFI? Entonces el menú se muestra y lo ofrece; si OweeLinux está solo, el arranque es directo y sin menú.
ESPD=$BOOT/efi/EFI
if [ -d "$ESPD" ]; then
  for d in "$ESPD"/*/; do
    name=$(basename "$d"); case "$name" in BOOT|debian|owee|oweelinux|OWEE) continue ;; esac
    case "$name" in *[!A-Za-z0-9._-]*|"") continue ;; esac
    efi=$(ls "$d"Boot/bootmgfw.efi "$d"shimx64.efi "$d"grubx64.efi 2>/dev/null | head -1); [ -n "$efi" ] || continue
    rel=${efi#"$BOOT/efi"}; label=$name; [ "$name" = Microsoft ] && label="Windows"
    printf "menuentry '%s' --id 'otro-%s' {\n    search --no-floppy --file --set=root '%s'\n    chainloader '%s'\n}\n" "$label" "$name" "$rel" "$rel" >> "$chain"
  done
elif [ -f "$OUT" ]; then      # la partición EFI no está montada ahora: se conservan las entradas de otros sistemas que ya había
  awk "/^menuentry .*--id 'otro-/{p=1} p{print} p&&/^}/{p=0}" "$OUT" >> "$chain"
fi
for e in $(ls -1 "$BOOT"/loader/entries/ostree-*.conf | sort -r -V); do
  title=$(sed -n 's/^title //p' "$e" | sed 's/ *(ostree[^)]*)//; s/Debian GNU\/Linux[^ ]* *//'); linux=$(sed -n 's/^linux //p' "$e")
  initrd=$(sed -n 's/^initrd //p' "$e"); opts=$(sed -n 's/^options //p' "$e")
  id=$(id_of "$opts"); [ -n "$first" ] || first=$id
  { echo "menuentry '$title' --id 'owee-$id' {"
    echo "    linux /boot$linux $opts $EXTRA"
    echo "    initrd /boot$initrd"
    echo "}"; } >> "$body"
  if [ "$n" = 0 ]; then       # una entrada más para la versión más nueva: modo seguro (gráficos por software), por si la pantalla sale negra
    { echo "menuentry '$title (modo seguro)' --id 'owee-safe' {"
      echo "    linux /boot$linux $opts $EXTRA owee.safe=1"
      echo "    initrd /boot$initrd"
      echo "}"; } >> "$body.safe"
  fi
  n=$((n+1))
done
[ -f "$body.safe" ] && { cat "$body.safe" >> "$body"; rm -f "$body.safe"; }
[ "$n" -gt 0 ] || { echo "owee-bootcfg: no hay entradas BLS en $BOOT/loader/entries" >&2; rm -f "$body"; exit 1; }
[ -f "$ENV" ] || { owee-env "$ENV" set trial 0; owee-env "$ENV" set confirmed "$first"; }
{ if [ -s "$chain" ]; then echo "set timeout=5"; else printf 'set timeout_style=hidden\nset timeout=1\n'; fi   # sin otros sistemas: sin menú (Mayús o Esc al encender lo muestran)
  cat <<'EOC'
load_env -f /boot/owee/grubenv
if [ "${trial}" = "1" ]; then
    set trial=0
    save_env -f /boot/owee/grubenv trial
    set default=0
elif [ -n "${confirmed}" ]; then
    set default="owee-${confirmed}"
else
    set default=0
fi
EOC
  cat "$body" "$chain"; } > "$OUT.new"
rm -f "$body" "$chain"; mv "$OUT.new" "$OUT"
echo "owee-bootcfg: $n entradas escritas en $OUT"
