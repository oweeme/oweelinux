#!/bin/sh
# (como root) Guarda en /run/owee/home-uuid la partición que será /home (UUID) o la borra («none»). La lee owee-install-deploy. Ver owee_install_choice.py.
mkdir -p /run/owee
case "${1:-none}" in none|"") rm -f /run/owee/home-uuid ;; *) blkid -U "$1" >/dev/null 2>&1 && printf '%s\n' "$1" > /run/owee/home-uuid || { echo "partición no encontrada" >&2; exit 1; } ;; esac
