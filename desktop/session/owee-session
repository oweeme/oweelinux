#!/bin/sh
# Arranque de la sesión "OweeLinux Lite": prepara el entorno y entrega el control al compositor (labwc).
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=OweeLite XDG_SESSION_DESKTOP=owee-lite
export QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1
[ -e /usr/lib/libreoffice/program/libvclplug_kf6lo.so ] && export SAL_USE_VCLPLUGIN=kf6      # LibreOffice con el estilo de KDE (si no, elige el genérico y se ve gris y ajeno al escritorio)
# Apps de KDE (Dolphin → «Abrir con…», diálogos de aplicaciones): necesitan el menú de aplicaciones de Plasma para construir su caché de servicios (ksycoca)
[ -f /etc/xdg/menus/plasma-applications.menu ] && export XDG_MENU_PREFIX=plasma-
# Apps Qt/KDE: tomar colores, fuentes e iconos de ~/.config/kdeglobals (lo escribe Ajustes → Apariencia); sin este tema de plataforma el modo oscuro no les llega
[ -e /usr/lib/x86_64-linux-gnu/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so ] && export QT_QPA_PLATFORMTHEME=kde
# Idioma: el elegido en Ajustes → Idioma (settings.json); si no hay, español. Solo se usa si ese locale existe en el sistema.
S="${XDG_CONFIG_HOME:-$HOME/.config}/owee/settings.json"
L=""; [ -f "$S" ] && command -v jq >/dev/null && L=$(jq -r '.lang // empty' "$S" 2>/dev/null)
. /usr/libexec/owee/owee-locale 2>/dev/null || . "$(dirname "$0")/owee-locale"; owee_locale "$L"
# Escribir en otros idiomas: Fcitx5 (pinyin, Mozc, Owee…). Las apps GTK y Qt lo usan por el protocolo nativo de Wayland (text-input): NO se fijan GTK_IM_MODULE ni QT_IM_MODULE
# (con ellas, Fcitx5 avisa «Wayland Diagnose» y no hacen falta; probado con GTK4 y Kate). XMODIFIERS solo sirve a las apps de X11 (XWayland).
if command -v fcitx5 >/dev/null; then export XMODIFIERS=@im=fcitx; unset GTK_IM_MODULE QT_IM_MODULE; fi
# Apps Flatpak (Bazaar y las que se instalen): sus lanzadores e iconos están en /var/lib/flatpak y ~/.local/share/flatpak
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"
# En una máquina virtual no hay GPU: gráficos por software (en hardware real NO se tocan)
if { command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; } || grep -qw owee.safe /proc/cmdline 2>/dev/null; then export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo; fi
# GPU NVIDIA con el controlador privativo: el cursor por hardware suele fallar en wlroots; software es seguro
[ -d /proc/driver/nvidia ] && export WLR_NO_HARDWARE_CURSORS=1
# Ajustes opcionales de la máquina (p. ej. en una VM: WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo)
# set -a: las variables del archivo se EXPORTAN (con un simple `source` quedaban solo en el shell y no llegaban a labwc ni al panel)
if [ -f /etc/owee/lite.env ]; then set -a; . /etc/owee/lite.env; set +a; fi
exec /usr/libexec/owee/owee-run-labwc
