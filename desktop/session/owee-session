#!/bin/sh
# Arranque de la sesión "OweeLinux Lite": prepara el entorno y entrega el control al compositor (labwc).
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=OweeLite XDG_SESSION_DESKTOP=owee-lite
export QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1
# Apps Qt/KDE: tomar colores, fuentes e iconos de ~/.config/kdeglobals (lo escribe Ajustes → Apariencia); sin este tema de plataforma el modo oscuro no les llega
[ -e /usr/lib/x86_64-linux-gnu/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so ] && export QT_QPA_PLATFORMTHEME=kde
# Idioma: el elegido en Ajustes → Idioma (settings.json); si no hay, español. Solo se usa si ese locale existe en el sistema.
S="${XDG_CONFIG_HOME:-$HOME/.config}/owee/settings.json"
L=""; [ -f "$S" ] && command -v jq >/dev/null && L=$(jq -r '.lang // empty' "$S" 2>/dev/null)
case "$L" in
  es) LOC=es_ES.UTF-8; LNG=es ;;      en) LOC=en_US.UTF-8; LNG=en ;;      pt) LOC=pt_BR.UTF-8; LNG=pt:en ;;   fr) LOC=fr_FR.UTF-8; LNG=fr:en ;;
  de) LOC=de_DE.UTF-8; LNG=de:en ;;   ru) LOC=ru_RU.UTF-8; LNG=ru:en ;;   zh) LOC=zh_CN.UTF-8; LNG=zh:en ;;   ja) LOC=ja_JP.UTF-8; LNG=ja:en ;;
  qow) LOC=qow_BO.UTF-8; LNG=qow:es ;; qow@owee) LOC=qow_BO.UTF-8; LNG=qow@owee:qow:es ;;
  *) case "${LANG:-C}" in C|C.*|POSIX) LOC=es_ES.UTF-8; LNG=es ;; *) LOC=""; LNG="" ;; esac ;;
esac
if [ -n "$LOC" ] && locale -a 2>/dev/null | grep -qix "$(echo "$LOC" | sed 's/UTF-8/utf8/')"; then export LANG="$LOC"; [ -n "$LNG" ] && export LANGUAGE="$LNG"; fi
# Escribir en otros idiomas: Fcitx5 (pinyin, Mozc, Owee…). Se activa si está instalado; los programas lo usan por estas variables.
if command -v fcitx5 >/dev/null; then export XMODIFIERS=@im=fcitx QT_IM_MODULE=fcitx GTK_IM_MODULE=fcitx; fi
# En una máquina virtual no hay GPU: gráficos por software (en hardware real NO se tocan)
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo; fi
# Ajustes opcionales de la máquina (p. ej. en una VM: WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo)
# set -a: las variables del archivo se EXPORTAN (con un simple `source` quedaban solo en el shell y no llegaban a labwc ni al panel)
if [ -f /etc/owee/lite.env ]; then set -a; . /etc/owee/lite.env; set +a; fi
exec labwc
