#!/bin/sh
# Tienda de apps de OweeLinux: Discover (de KDE, ya en la imagen) con el backend de Flatpak. Este servicio (owee-store.service) solo AÑADE el repositorio Flathub la primera vez que hay red
# (unos KB: nada de descargar una tienda ni su runtime) y deja un ajuste para que las apps Flatpak vean el tema; las apps las instala quien las pida desde la tienda.
# Las apps Flatpak viven en /var/lib/flatpak (la parte persistente): el sistema inmutable (/usr) no se toca. Si no hay red, se reintenta en el siguiente arranque.
set -u
MARK=/var/lib/flatpak/.owee-store-ok
[ -e "$MARK" ] && exit 0
command -v flatpak >/dev/null || { echo "owee-store: falta flatpak"; exit 0; }
# Al arrancar la red puede tardar: se reintenta cada 20 s durante 15 minutos (acotado: nunca espera para siempre)
n=0; until timeout 60 flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; do
  n=$((n + 1)); [ "$n" -ge 45 ] && { echo "owee-store: sin red para Flathub (se reintentará en el próximo arranque)"; exit 0; }; sleep 20; done
# Que las apps Flatpak (libadwaita/GTK) vean el tema y los colores elegidos en Ajustes → Apariencia
flatpak override --system --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/fontconfig:ro
# Catálogo de apps (appstream, unos MB): se descarga ya, en segundo plano, para que Discover muestre las apps al abrirlo (con internet lento, si no, parece vacío). Si no llega, se reintenta en el próximo arranque
if timeout 1200 flatpak update --appstream --system -y flathub >/dev/null 2>&1; then touch "$MARK"; echo "owee-store: Flathub y catálogo listos"
else echo "owee-store: no se pudo descargar el catálogo (se reintentará en el próximo arranque; Discover también lo intenta al abrirse)"; fi
exit 0
