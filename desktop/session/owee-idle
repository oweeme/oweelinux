#!/bin/sh
# Inactividad: lee ~/.config/owee/power.json y (re)inicia swayidle: bloquear la pantalla y suspender tras N minutos (0 = nunca). Lo usa la sesión y la página Energía de Ajustes.
S="${XDG_CONFIG_HOME:-$HOME/.config}/owee/power.json"
LOCK=10; SUSP=0
if [ -f "$S" ]; then
  LOCK=$(jq -r '.lock_min // 10' "$S" 2>/dev/null || echo 10); SUSP=$(jq -r '.suspend_min // 0' "$S" 2>/dev/null || echo 0)
fi
pkill -x swayidle 2>/dev/null
set --
[ "$LOCK" -gt 0 ] 2>/dev/null && set -- "$@" timeout $((LOCK * 60)) 'swaylock -f -c 102019'
[ "$SUSP" -gt 0 ] 2>/dev/null && set -- "$@" timeout $((SUSP * 60)) 'systemctl suspend'
[ $# -gt 0 ] && exec swayidle -w "$@" before-sleep 'swaylock -f -c 102019'
exit 0
