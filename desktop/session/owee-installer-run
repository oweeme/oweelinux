#!/bin/sh
# Calamares necesita ser root: pkexec (regla polkit solo para el usuario owee-installer). Se le pasa la pantalla de esta sesión.
# SEGURIDAD: el disco desde el que arrancó el instalador se OCULTA a Calamares (espacio de montajes propio donde su carpeta de /sys queda vacía), para que nadie pueda
# elegirlo —ni por error ni por ser el primero de la lista— y borrar el medio que está usando.
/usr/libexec/owee/owee-wallpaper &
pkexec env WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland /usr/libexec/owee/owee-installer-calamares
kill %1 2>/dev/null
