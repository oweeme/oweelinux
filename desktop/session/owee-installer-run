#!/bin/sh
# Sesión del instalador: 1) si ya hay un OweeLinux con datos, pregunta si reinstalar conservándolos o borrar el disco; 2) Calamares (borrar disco e instalar de cero).
# Calamares necesita ser root: pkexec (regla polkit solo para el usuario owee-installer).
# SEGURIDAD: el disco desde el que arrancó el instalador se OCULTA a Calamares (ver owee-installer-calamares) para que nadie lo borre por error.
/usr/libexec/owee/owee-wallpaper &
python3 /usr/libexec/owee/installer/owee_install_choice.py; rc=$?
if [ "$rc" -ne 20 ]; then
  pkexec env LANG=es_ES.UTF-8 LANGUAGE=es WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland /usr/libexec/owee/owee-installer-calamares
fi
kill %1 2>/dev/null
