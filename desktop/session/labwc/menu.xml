<?xml version="1.0" encoding="UTF-8"?>
<!-- Respaldo del menú del escritorio. Con los iconos del escritorio encendidos (Ajustes → Fondo de pantalla) el clic derecho lo muestra owee_icons.py, no labwc;
     este menú solo se ve si esos iconos están apagados (y entonces solo con clic derecho, ver rc.xml). Cópialo a ~/.config/labwc/menu.xml para cambiarlo. -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Abrir en terminal"><action name="Execute" command="foot"/></item>
    <item label="Archivos"><action name="Execute" command="dolphin"/></item>
    <separator/>
    <item label="Configuración de pantalla"><action name="Execute" command="env OWEE_PAGE=pantalla /usr/libexec/owee/owee_settings.py"/></item>
    <item label="Establecer fondo"><action name="Execute" command="env OWEE_PAGE=fondo /usr/libexec/owee/owee_settings.py"/></item>
  </menu>
</openbox_menu>
