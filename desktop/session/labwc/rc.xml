<?xml version="1.0"?>
<labwc_config>
  <core><gap>4</gap></core>
  <theme>
    <name>Owee</name>
    <cornerRadius>10</cornerRadius>
    <font place="" name="Noto Sans" size="10"/>
  </theme>
  <!-- Botones de ventana: cerrar/maximizar/minimizar a la DERECHA (el icono a la izquierda) -->
  <titlebar><layout>icon:iconify,max,close</layout><showTitle>yes</showTitle></titlebar>
  <desktops><number>4</number><popupTime>700</popupTime></desktops>
  <keyboard>
    <default />
    <!-- Atajos propios (Super = tecla Windows). Alt+Tab, Alt+F4 y mover/redimensionar con Alt+ratón ya vienen de labwc -->
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
    <keybind key="W-space"><action name="Execute" command="gapplication action org.oweelinux.PanelPrototype launcher"/></keybind>
    <keybind key="W-S-space"><action name="Execute" command="/usr/libexec/owee/owee-layout next"/></keybind>
    <keybind key="W-a"><action name="Execute" command="gapplication action org.oweelinux.PanelPrototype overview"/></keybind>
    <keybind key="W-c"><action name="Execute" command="gapplication action org.oweelinux.PanelPrototype calendar"/></keybind>
    <keybind key="W-e"><action name="Execute" command="dolphin"/></keybind>
    <keybind key="W-l"><action name="Execute" command="/usr/libexec/owee/owee-lock"/></keybind>
    <keybind key="W-1"><action name="Execute" command="/usr/libexec/owee/owee-desktop 1"/><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1"/><action name="Execute" command="/usr/libexec/owee/owee-desktop 1"/></keybind>
    <keybind key="W-A-F1"><action name="Execute" command="/usr/libexec/owee/owee-desktop 1"/><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="Execute" command="/usr/libexec/owee/owee-desktop 2"/><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2"/><action name="Execute" command="/usr/libexec/owee/owee-desktop 2"/></keybind>
    <keybind key="W-A-F2"><action name="Execute" command="/usr/libexec/owee/owee-desktop 2"/><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="Execute" command="/usr/libexec/owee/owee-desktop 3"/><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3"/><action name="Execute" command="/usr/libexec/owee/owee-desktop 3"/></keybind>
    <keybind key="W-A-F3"><action name="Execute" command="/usr/libexec/owee/owee-desktop 3"/><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="Execute" command="/usr/libexec/owee/owee-desktop 4"/><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4"/><action name="Execute" command="/usr/libexec/owee/owee-desktop 4"/></keybind>
    <keybind key="W-A-F4"><action name="Execute" command="/usr/libexec/owee/owee-desktop 4"/><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="C-A-Left"><action name="Execute" command="/usr/libexec/owee/owee-desktop left"/><action name="GoToDesktop" to="left"/></keybind>
    <keybind key="C-A-Right"><action name="Execute" command="/usr/libexec/owee/owee-desktop right"/><action name="GoToDesktop" to="right"/></keybind>
    <!-- Vista general: lista de todas las ventanas de todos los escritorios (clic para ir a una). W-A-F9 lo usa el panel y las esquinas activas -->
    <keybind key="W-Tab"><action name="ShowMenu" menu="client-list-combined-menu"/></keybind>
    <keybind key="W-A-F9"><action name="ShowMenu" menu="client-list-combined-menu"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge"><direction>left</direction></action></keybind>
    <keybind key="W-Right"><action name="SnapToEdge"><direction>right</direction></action></keybind>
    <keybind key="Print"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --shot full"/></keybind>
    <keybind key="S-Print"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --shot region"/></keybind>
    <keybind key="C-Print"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py"/></keybind>
    <keybind key="W-A-r"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --record full"/></keybind>
    <keybind key="W-A-S-r"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --record region"/></keybind>
    <keybind key="W-A-p"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --present"/></keybind>
    <keybind key="W-A-c"><action name="Execute" command="/usr/libexec/owee/apps/capturadora/owee_capture.py --camera"/></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set 5%+"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-"/></keybind>
  </keyboard>
  <mouse>
    <default />
    <!-- Rueda del ratón sobre el escritorio: cambia de escritorio (se activa o quita desde Ajustes → Escritorios) -->
    <context name="Root">
      <mousebind button="Up" direction="Up" action="Scroll"><action name="Execute" command="/usr/libexec/owee/owee-desktop left"/><action name="GoToDesktop" to="left"/></mousebind>
      <mousebind button="Down" direction="Down" action="Scroll"><action name="Execute" command="/usr/libexec/owee/owee-desktop right"/><action name="GoToDesktop" to="right"/></mousebind>
    </context>
  </mouse>
</labwc_config>
