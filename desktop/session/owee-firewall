#!/bin/sh
# Cortafuegos de OweeLinux (nftables): BLOQUEA lo entrante salvo lo que el usuario abra; lo saliente y lo reenviado no se tocan (navegar, actualizar, compartir internet y contenedores siguen igual).
# Uso: owee-firewall apply | status | on | off | allow PUERTO/tcp|udp | deny PUERTO/tcp|udp | list     (todo menos status/list necesita ser administrador; Ajustes → Seguridad lo hace con pkexec)
# Estado persistente en /etc/owee/firewall.conf: ENABLED=1|0 y ALLOW="22/tcp 3000/tcp …". Los conjuntos blocked4/blocked6/decoy_tcp los usa Centinela (owee-centinela).
CONF=${OWEE_FIREWALL_CONF:-/etc/owee/firewall.conf}
ENABLED=1; ALLOW=""
[ -f "$CONF" ] && . "$CONF"
save() { mkdir -p "$(dirname "$CONF")"; printf 'ENABLED=%s\nALLOW="%s"\n' "$ENABLED" "$ALLOW" > "$CONF"; }
valid() { echo "$1" | grep -Eq '^[0-9]{1,5}/(tcp|udp)$' && [ "${1%/*}" -ge 1 ] && [ "${1%/*}" -le 65535 ]; }
ruleset() { cat <<'NFT'
table inet owee
delete table inet owee
table inet owee {
  set blocked4 { type ipv4_addr; flags timeout; }
  set blocked6 { type ipv6_addr; flags timeout; }
  set allow_tcp { type inet_service; }
  set allow_udp { type inet_service; }
  set decoy_tcp { type inet_service; }
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    ip saddr @blocked4 drop
    ip6 saddr @blocked6 drop
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 20/second accept
    ip6 nexthdr icmpv6 accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    udp dport { 53, 67, 5353 } accept
    tcp dport 53 accept
    tcp dport @allow_tcp accept
    udp dport @allow_udp accept
    tcp dport @decoy_tcp accept
  }
}
NFT
}
apply() {
  if [ "$ENABLED" != 1 ]; then nft delete table inet owee 2>/dev/null; echo "cortafuegos desactivado"; return 0; fi
  ruleset | nft -f - || { echo "owee-firewall: no se pudo cargar el conjunto de reglas" >&2; return 1; }
  for p in $ALLOW; do add_elem "$p"; done
  echo "cortafuegos activo: lo entrante bloqueado${ALLOW:+ salvo $ALLOW}"
}
add_elem() { nft add element inet owee "allow_${1#*/}" "{ ${1%/*} }" 2>/dev/null; }
del_elem() { nft delete element inet owee "allow_${1#*/}" "{ ${1%/*} }" 2>/dev/null; }
case "${1:-status}" in
  apply) apply ;;
  on) ENABLED=1; save; apply ;;
  off) ENABLED=0; save; apply ;;
  allow) valid "${2:-}" || { echo "uso: owee-firewall allow PUERTO/tcp|udp (p. ej. 22/tcp)" >&2; exit 2; }
         case " $ALLOW " in *" $2 "*) ;; *) ALLOW="${ALLOW:+$ALLOW }$2" ;; esac; save; [ "$ENABLED" = 1 ] && add_elem "$2"; echo "abierto: $2" ;;
  deny)  valid "${2:-}" || { echo "uso: owee-firewall deny PUERTO/tcp|udp" >&2; exit 2; }
         ALLOW=$(echo " $ALLOW " | sed "s# $2 # #g; s/^ *//; s/ *$//"); save; del_elem "$2"; echo "cerrado: $2" ;;
  list) echo "$ALLOW" | tr ' ' '\n' | grep . ;;
  status) if nft list table inet owee >/dev/null 2>&1; then echo "estado=activo"; else echo "estado=inactivo"; fi; echo "permitidos=$ALLOW" ;;
  *) echo "uso: owee-firewall apply|status|on|off|allow P/tcp|deny P/tcp|list" >&2; exit 2 ;;
esac
