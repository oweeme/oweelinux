#!/bin/sh
# Sesión del asistente de primer arranque: labwc a pantalla completa con el asistente y nada más. Al cerrarse el asistente, la sesión termina.
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=OweeLite
[ -n "$HOME" ] && mkdir -p "$HOME/.config/owee"
if { command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; } || grep -qw owee.safe /proc/cmdline 2>/dev/null; then export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo; fi
S="${HOME:-/tmp}/.config/owee/settings.json"; L=""; [ -f "$S" ] && command -v jq >/dev/null && L=$(jq -r '.lang // empty' "$S" 2>/dev/null)
. /usr/libexec/owee/owee-locale 2>/dev/null; owee_locale "$L"
# configuración mínima de labwc en la carpeta del usuario del asistente (así el teclado que se elige en el asistente, que se guarda ahí, sí se aplica); el autostart vacío evita el panel de la sesión Lite
mkdir -p "$HOME/.config/labwc"; cp /usr/share/owee/labwc-setup/rc.xml /usr/share/owee/labwc-setup/autostart "$HOME/.config/labwc/" 2>/dev/null
exec /usr/libexec/owee/owee-run-labwc -S /usr/libexec/owee/owee-setup-run
