#!/usr/bin/env python3
"""Ayudante con privilegios de Ajustes → Usuarios y Acceso. Se ejecuta como root con `pkexec` (la política polkit org.oweelinux.accounts pide la clave de administrador).
Reglas: solo estas órdenes, argumentos validados estrictamente, las contraseñas llegan SIEMPRE por la entrada estándar (nunca por argumentos) y nunca se toca una cuenta de sistema
(UID < 1000), ni se borra al usuario que lo invoca, ni se deja el equipo sin administradores.
Uso:  add USUARIO "Nombre completo" [admin]   (clave por stdin)      passwd USUARIO   (clave por stdin)
      delete USUARIO [keephome]               admin USUARIO on|off   rename USUARIO "Nombre completo"
      autologin USUARIO SESION.desktop | off
      logintheme [tema=owee|estandar] [position=left|center|right] [style=full|side] [blur=0|1] [background=none|keep|/ruta/imagen] [textos: password, hint, wrong, suspend, reboot, poweroff]
      firstboot USUARIO "Nombre completo" IDIOMA DISTRIBUCIONES INDICE ZONA   (clave por stdin; solo el usuario owee-setup, una vez, sin otros usuarios)"""
import grp, os, pwd, re, subprocess, sys
NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$"); SESSION = re.compile(r"^[A-Za-z0-9_.-]{1,64}\.desktop$"); ADMIN = "sudo"; GROUPS = ["audio", "video", "plugdev", "netdev", "systemd-journal"]
SDDM = "/etc/sddm.conf.d/30-owee-autologin.conf"

def die(msg, code=2): print("ERR: " + msg); sys.exit(code)            # el mensaje sale por stdout: Ajustes lo muestra tal cual
def sh(*a, stdin=None):
    r = subprocess.run(list(a), input=stdin, capture_output=True, text=True, timeout=60)
    if r.returncode != 0: die((r.stderr or r.stdout or "falló " + a[0]).strip(), 1)
def human(name):
    if not NAME.match(name or ""): die("nombre de usuario no válido (minúsculas, cifras, - y _; empieza por letra)")
    try: u = pwd.getpwnam(name)
    except KeyError: die("ese usuario no existe")
    if u.pw_uid < 1000 or u.pw_uid >= 60000: die("las cuentas del sistema no se tocan")
    return u
def full(s):
    s = (s or "").strip()
    if not s or len(s) > 60 or any(c in s for c in ":,\n\r\\") or not s.isprintable(): die("nombre completo no válido")
    return s
def admins():
    try: g = grp.getgrnam(ADMIN); return {m for m in g.gr_mem if m in {p.pw_name for p in pwd.getpwall()}}
    except KeyError: return set()
def password():
    p = sys.stdin.readline().rstrip("\n")
    if not (1 <= len(p) <= 200) or "\n" in p or "\x00" in p: die("contraseña no válida")
    return p
def caller():
    try: return pwd.getpwuid(int(os.environ.get("PKEXEC_UID", "-1"))).pw_name
    except (KeyError, ValueError): return ""

a = sys.argv[1:]
if os.geteuid() != 0: die("hay que ejecutarlo como administrador (pkexec)")
if not a: die(__doc__)
op = a[0]
if op == "add" and len(a) in (3, 4):
    name = a[1]
    if not NAME.match(name): die("nombre de usuario no válido (minúsculas, cifras, - y _; empieza por letra)")
    try: pwd.getpwnam(name); die("ese usuario ya existe")
    except KeyError: pass
    fn = full(a[2]); pw = password(); isadmin = len(a) == 4 and a[3] == "admin"
    if isadmin: sh("groupadd", "-f", ADMIN)
    groups = [g for g in GROUPS if any(x.gr_name == g for x in grp.getgrall())]
    sh("useradd", "-m", "-s", "/bin/bash", "-c", fn, "-G", ",".join(groups + ([ADMIN] if isadmin else [])), name); sh("chpasswd", stdin=f"{name}:{pw}\n")
elif op == "passwd" and len(a) == 2: human(a[1]); sh("chpasswd", stdin=f"{a[1]}:{password()}\n")
elif op == "delete" and len(a) in (2, 3):
    u = human(a[1])
    if u.pw_name == caller(): die("no puedes borrar la cuenta con la que has entrado")
    if admins() <= {u.pw_name} and u.pw_name in admins(): die("es el único administrador: no se puede borrar")
    sh("userdel", *([] if len(a) == 3 and a[2] == "keephome" else ["-r"]), u.pw_name)
elif op == "admin" and len(a) == 3 and a[2] in ("on", "off"):
    u = human(a[1])
    if a[2] == "on": sh("groupadd", "-f", ADMIN); sh("gpasswd", "-a", u.pw_name, ADMIN)
    else:
        if admins() <= {u.pw_name}: die("es el único administrador: déjalo como está")
        sh("gpasswd", "-d", u.pw_name, ADMIN)
elif op == "rename" and len(a) == 3: u = human(a[1]); sh("usermod", "-c", full(a[2]), u.pw_name)
elif op == "firstboot" and len(a) == 7:
    import json, shutil
    DONE = "/var/lib/owee/firstboot-done"
    if caller() != "owee-setup": die("solo el asistente de primer arranque puede hacer esto")
    if os.path.exists(DONE) or any(1000 <= p.pw_uid < 60000 for p in pwd.getpwall()): die("este equipo ya está configurado")
    name, fn, lang, lays, idx, tz = a[1], full(a[2]), a[3], a[4], a[5], a[6]
    if not NAME.match(name): die("nombre de usuario no válido (minúsculas, cifras, - y _; empieza por letra)")
    sys.path.insert(0, "/usr/libexec/owee"); sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "shell"))
    import owee_i18n
    if lang not in {c for c, _n, _l in owee_i18n.LANGS}: die("idioma no válido")
    allowed = set(owee_i18n.all_layouts()) | {"latam", "es", "pt", "gb", "kr", "jp", "us(intl)", "in(bolnagri)"}
    lay = [x for x in lays.split(",") if x]
    if not (1 <= len(lay) <= 4) or any(x not in allowed for x in lay): die("distribución de teclado no válida")
    if not idx.isdigit() or int(idx) >= len(lay): die("distribución activa no válida")
    if not re.fullmatch(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*", tz) or not os.path.isfile("/usr/share/zoneinfo/" + tz): die("zona horaria no válida")
    pw = password()
    sh("groupadd", "-f", ADMIN); groups = [g for g in GROUPS if any(x.gr_name == g for x in grp.getgrall())]
    # ¿ya existe la carpeta personal (un disco /home reutilizado)? Se conserva tal cual y el usuario toma el mismo UID para que los archivos sigan siendo suyos
    homedir = f"/var/home/{name}"; ids = []
    if os.path.isdir(homedir) and not os.path.islink(homedir):
        st = os.stat(homedir)
        if 1000 <= st.st_uid < 60000:
            if st.st_uid in {p.pw_uid for p in pwd.getpwall()}: die("la carpeta personal existente pertenece a otro usuario del sistema")
            ids = ["-u", str(st.st_uid), "-M", "-d", "/home/" + name]
            if not any(g.gr_gid == st.st_gid for g in grp.getgrall()) and 1000 <= st.st_gid < 60000: sh("groupadd", "-g", str(st.st_gid), name); ids += ["-g", str(st.st_gid)]
    sh("useradd", *(ids or ["-m"]), "-s", "/bin/bash", "-c", fn, "-G", ",".join(groups + [ADMIN]), name); sh("chpasswd", stdin=f"{name}:{pw}\n")
    u = pwd.getpwnam(name); cfg = os.path.join(u.pw_dir, ".config"); os.makedirs(os.path.join(cfg, "owee"), exist_ok=True); os.makedirs(os.path.join(cfg, "labwc"), exist_ok=True)
    key = lay[int(idx)]; base, _s, var = key.partition("(")
    json.dump({"lang": lang, "layouts": lay, "layout_idx": int(idx)}, open(os.path.join(cfg, "owee", "settings.json"), "w"), indent=1)
    open(os.path.join(cfg, "labwc", "environment"), "w").write(f"XKB_DEFAULT_LAYOUT={base}\n" + (f"XKB_DEFAULT_VARIANT={var.rstrip(')')}\n" if var else ""))
    for root, dirs, files in os.walk(cfg):
        for n in dirs + files: os.chown(os.path.join(root, n), u.pw_uid, u.pw_gid)
    os.chown(cfg, u.pw_uid, u.pw_gid)
    tmp = "/etc/localtime.tmp"; (os.path.lexists(tmp) and os.remove(tmp)); os.symlink("/usr/share/zoneinfo/" + tz, tmp); os.replace(tmp, "/etc/localtime"); open("/etc/timezone", "w").write(tz + "\n")
    loc = next(l for c, _n, l in owee_i18n.LANGS if c == lang)
    open("/etc/default/locale", "w").write(f"LANG={loc}\n")
    open("/etc/default/keyboard", "w").write(f'XKBLAYOUT="{base}"\nXKBVARIANT="{var.rstrip(")")}"\nXKBOPTIONS=""\nBACKSPACE="guess"\n')
    os.makedirs("/var/lib/sddm", exist_ok=True)
    open("/var/lib/sddm/state.conf", "w").write(f"[Last]\nSession=/usr/share/wayland-sessions/owee-lite.desktop\nUser={name}\n")
    os.makedirs(os.path.dirname(DONE), exist_ok=True); open(DONE, "w").write("listo\n")
    try: os.remove("/etc/sddm.conf.d/05-owee-setup.conf")
    except OSError: pass
    subprocess.Popen(["systemd-run", "--no-block", "--on-active=3", "systemctl", "restart", "sddm.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
elif op == "autologin" and len(a) in (2, 3):
    os.makedirs(os.path.dirname(SDDM), exist_ok=True)
    if a[1] == "off": text = "[Autologin]\nUser=\nSession=\n"
    else:
        u = human(a[1])
        if len(a) != 3 or not SESSION.match(a[2]): die("sesión no válida")
        text = f"[Autologin]\nUser={u.pw_name}\nSession={a[2]}\nRelogin=false\n"
    tmp = SDDM + ".tmp"; open(tmp, "w").write(text); os.replace(tmp, SDDM)
elif op == "logintheme" and 1 <= len(a) <= 14:
    # Aspecto del inicio de sesión (tema «owee» de SDDM): escribe theme.conf.user en /var/lib/owee/login (el tema lo enlaza). Todo se valida; la imagen la lee y reduce el USUARIO que llama (no root), así nadie puede usar esto para leer archivos ajenos.
    D = "/var/lib/owee/login"; CONF = D + "/theme.conf.user"; THEME = "/etc/sddm.conf.d/29-owee-theme-user.conf"
    kv = {}
    for x in a[1:]:
        if "=" not in x: die("argumento no válido: " + x[:40])
        k, v = x.split("=", 1); kv[k] = v
    ALLOWED = {"tema", "position", "style", "blur", "background", "password", "hint", "wrong", "suspend", "reboot", "poweroff"}
    if set(kv) - ALLOWED: die("opción desconocida: " + ", ".join(sorted(set(kv) - ALLOWED)))
    if kv.get("tema", "owee") not in ("owee", "estandar"): die("tema no válido")
    if kv.get("position", "center") not in ("left", "center", "right"): die("posición no válida")
    if kv.get("style", "full") not in ("full", "side"): die("estilo no válido")
    if kv.get("blur", "0") not in ("0", "1"): die("desenfoque no válido")
    for k in ("password", "hint", "wrong", "suspend", "reboot", "poweroff"):
        if k in kv and (not 1 <= len(kv[k]) <= 80 or any(ord(ch) < 32 or ch in '"\\' for ch in kv[k])): die("texto no válido: " + k)
    old = {}
    try:
        for l in open(CONF, encoding="utf-8").read().splitlines():
            if "=" in l and not l.startswith("["): k, v = l.split("=", 1); old[k.strip()] = v.strip().strip('"')
    except OSError: pass
    os.makedirs(D, exist_ok=True); os.chmod(D, 0o755)
    cfg = {**old, **{k: v for k, v in kv.items() if k not in ("tema", "background", "blur")}}
    bg = kv.get("background", "keep")
    if bg == "none": cfg["background"] = ""; 
    elif bg != "keep":
        if not bg.startswith("/") or ".." in bg.split("/") or not os.path.isfile(bg): die("imagen no válida")
        uid = int(os.environ.get("PKEXEC_UID", "-1"))
        if uid < 1000: die("no se pudo saber quién llama")
        pw_ = pwd.getpwuid(uid); blur = ",gblur=sigma=14" if kv.get("blur", "0") == "1" else ""
        r = subprocess.run(["ffmpeg", "-v", "error", "-i", bg, "-vf", f"scale='min(1920,iw)':-2{blur}", "-frames:v", "1", "-q:v", "3", "-f", "image2pipe", "-c:v", "mjpeg", "-"], capture_output=True, timeout=60, user=uid, group=pw_.pw_gid, env={"PATH": "/usr/bin:/bin", "HOME": "/tmp"})
        if r.returncode != 0 or len(r.stdout) < 2000: die("no se pudo leer la imagen (¿es una imagen válida?)")
        tmpi = D + "/background.jpg.tmp"; open(tmpi, "wb").write(r.stdout); os.chmod(tmpi, 0o644); os.replace(tmpi, D + "/background.jpg"); cfg["background"] = D + "/background.jpg"
    lines = ["[General]"] + [f'{k}="{v}"' for k, v in cfg.items() if k in ALLOWED and k not in ("tema", "blur")]
    tmpc = CONF + ".tmp"; open(tmpc, "w", encoding="utf-8").write("\n".join(lines) + "\n"); os.chmod(tmpc, 0o644); os.replace(tmpc, CONF)
    if "tema" in kv:                                                        # «estandar» = el tema Breeze de SDDM; «owee» = el de OweeLinux (quita la excepción)
        if kv["tema"] == "estandar":
            os.makedirs("/etc/sddm.conf.d", exist_ok=True); open(THEME, "w").write("[Theme]\nCurrent=breeze\n")
        else:
            try: os.remove(THEME)
            except OSError: pass
else: die(__doc__)
print("ok")
