# Biblioteca de shell (se carga con «.»): owee_locale CODIGO fija LANG y LANGUAGE según el idioma de Ajustes (settings.json), solo si ese locale existe en el sistema.
# Misma tabla que desktop/shell/owee_i18n.py (LANGS); tools/i18n/consistency.py comprueba que no se desincronicen.
owee_locale() {
  # idiomas que el usuario añadió (Ajustes → Idioma): sus locales viven en ~/.local/share/owee/locales y se usan con LOCPATH
  LD="${XDG_DATA_HOME:-$HOME/.local/share}/owee/locales"; [ -d "$LD" ] && export LOCPATH="$LD${LOCPATH:+:$LOCPATH}"
  case "$1" in
    es) LOC=es_ES.UTF-8; LNG=es ;;      en) LOC=en_US.UTF-8; LNG=en ;;      pt) LOC=pt_BR.UTF-8; LNG=pt:en ;;   fr) LOC=fr_FR.UTF-8; LNG=fr:en ;;
    de) LOC=de_DE.UTF-8; LNG=de:en ;;   it) LOC=it_IT.UTF-8; LNG=it:en ;;   ru) LOC=ru_RU.UTF-8; LNG=ru:en ;;   uk) LOC=uk_UA.UTF-8; LNG=uk:en ;;
    zh) LOC=zh_CN.UTF-8; LNG=zh:en ;;   ja) LOC=ja_JP.UTF-8; LNG=ja:en ;;   ko) LOC=ko_KR.UTF-8; LNG=ko:en ;;   ar) LOC=ar_SA.UTF-8; LNG=ar:en ;;
    fa) LOC=fa_IR.UTF-8; LNG=fa:en ;;   hi) LOC=hi_IN.UTF-8; LNG=hi:en ;;   ur) LOC=ur_PK.UTF-8; LNG=ur:en ;;   id) LOC=id_ID.UTF-8; LNG=id:en ;;
    ms) LOC=ms_MY.UTF-8; LNG=ms:en ;;
    pl) LOC=pl_PL.UTF-8; LNG=pl:en ;;   fi) LOC=fi_FI.UTF-8; LNG=fi:en ;;   sv) LOC=sv_SE.UTF-8; LNG=sv:en ;;
    qow) LOC=qow_BO.UTF-8; LNG=qow:es ;; qow@owee) LOC=qow_BO.UTF-8; LNG=qow@owee:qow:es ;;
    *) X=""; SJ="${XDG_CONFIG_HOME:-$HOME/.config}/owee/settings.json"
       [ -n "$1" ] && [ -f "$SJ" ] && command -v jq >/dev/null && X=$(jq -r --arg c "$1" '.extra_langs[$c].loc // empty' "$SJ" 2>/dev/null)
       if [ -n "$X" ]; then LOC="$X"; LNG="$1:en"
       else case "${LANG:-C}" in C|C.*|POSIX) LOC=es_ES.UTF-8; LNG=es ;; *) LOC=""; LNG="" ;; esac; fi ;;
  esac
  if [ -n "$LOC" ] && locale -a 2>/dev/null | grep -qix "$(echo "$LOC" | sed 's/UTF-8/utf8/')"; then export LANG="$LOC"; [ -n "$LNG" ] && export LANGUAGE="$LNG"; fi
}
